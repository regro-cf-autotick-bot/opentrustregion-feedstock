From 2fe5e49f62d8f1a671ee87dc7c931a05aa4dad12 Mon Sep 17 00:00:00 2001
From: "Lori A. Burns" <lori.burns7@gmail.com>
Date: Wed, 10 Jun 2026 19:20:49 -0400
Subject: [PATCH 1/1] allow cross-compiling flags

---
 CMakeLists.txt | 15 +++++++++++++--
 1 file changed, 13 insertions(+), 2 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index b662e05..b008247 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -46,10 +46,21 @@ endif()
 # set flags for build types
 if(CMAKE_Fortran_COMPILER_ID MATCHES "GNU")
     set(CMAKE_Fortran_FLAGS_DEBUG "-g -Wall -Wextra -fcheck=all -fbacktrace")
-    set(CMAKE_Fortran_FLAGS_RELEASE "-O2 -march=native")
+
+    if(CMAKE_CROSSCOMPILING)
+        set(CMAKE_Fortran_FLAGS_RELEASE "-O2")
+    else()
+        set(CMAKE_Fortran_FLAGS_RELEASE "-O2 -march=native")
+    endif()
+
 elseif(CMAKE_Fortran_COMPILER_ID MATCHES "Intel")
     set(CMAKE_Fortran_FLAGS_DEBUG "-g -warn all -traceback")
-    set(CMAKE_Fortran_FLAGS_RELEASE "-O2 -xHost")
+
+    if(CMAKE_CROSSCOMPILING)
+        set(CMAKE_Fortran_FLAGS_RELEASE "-O2")
+    else()
+        set(CMAKE_Fortran_FLAGS_RELEASE "-O2 -xHost")
+    endif()
 endif()
 
 # user-supplied integer size
-- 
